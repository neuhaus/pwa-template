{
  "name": "pwa-template",
  "version": "1.0.0",
  "description": "Minimal TypeScript PWA template with offline support, Web Push, Mobile Safari compatibility, Eta HTML templating, and CVE checks.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "check:cve": "node scripts/check-cve.ts",
    "generate:icons": "node scripts/generate-icons.ts"
  },
  "keywords": [
    "pwa",
    "typescript",
    "service-worker",
    "web-push",
    "mobile-safari",
    "eta"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eta": "^4.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
