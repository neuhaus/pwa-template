<meta charset="UTF-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0, viewport-fit=cover"
/>
<meta name="description" content="<%= it.description %>" />
<meta
  name="theme-color"
  content="<%= it.themeColorLight %>"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="theme-color"
  content="<%= it.themeColor %>"
  media="(prefers-color-scheme: dark)"
/>

<!-- Mobile Safari / iOS PWA configuration -->
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<meta
  name="apple-mobile-web-app-status-bar-style"
  content="<%= it.statusBarStyle %>"
/>
<meta name="apple-mobile-web-app-title" content="<%= it.shortName %>" />
<link rel="icon" type="image/png" sizes="192x192" href="<%= it.basePath %>icons/icon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="<%= it.basePath %>icons/apple-touch-icon.png" />

<!-- Web App Manifest -->
<link rel="manifest" href="<%= it.basePath %>manifest.webmanifest" />
<% if (it.isProd) { %>
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self';"
/>
<% } %>
<title><%= it.appName %></title>
